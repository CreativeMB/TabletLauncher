<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema Base en Negro Absoluto para la Ventana de Arranque -->
    <style name="Theme.TabletLauncher" parent="android:Theme.Material.NoActionBar">
        <!-- 1. Pinta el fondo de la ventana inicial en negro absoluto (Elimina la pantalla blanca) -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>

        <!-- 2. Configuración para Android 12 o superior (API 31+) -->
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/black</item>

        <!-- 3. Barras de estado y navegación del sistema en negro -->
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

</resources>